{
  "name": "@url-shortener/engine",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .turbo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "dev": "tsc --watch",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-support/index.ts",
    "./lifecycle": "./src/infra/prisma-client.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "ipaddr.js": "2.3.0",
    "lru-cache": "^11.5.1"
  }
}
