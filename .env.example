# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (SQLite via Prisma)
# Relative path resolves next to schema.prisma → libs/engine/prisma/dev.db (gitignored)
DATABASE_URL="file:./dev.db?socket_timeout=15"

# Short code length (default 7)
SHORT_CODE_LENGTH=7
# Redirect cache (defaults: 1000 entries, 300000ms / 5min)
CACHE_MAX_ENTRIES=1000
CACHE_TTL_MS=300000
# Rate-limit proxy trust — leave UNSET unless behind a header-scrubbing proxy
# TRUST_PROXY=1