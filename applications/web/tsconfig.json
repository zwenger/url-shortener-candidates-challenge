{
  "extends": "../../tsconfig.base.json",
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "noEmit": true,
    // server.ts (run directly by Node's native TypeScript support, outside
    // Vite's bundler) uses explicit `.ts` extensions in relative imports so
    // Node's ESM resolver can find them at runtime.
    "allowImportingTsExtensions": true
  }
}
